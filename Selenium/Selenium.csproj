<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Selenium</RootNamespace>
    <AssemblyName>Selenium</AssemblyName>
    <Configurations>Debug;Release;Test</Configurations>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Assembly and type library attributes (GUIDs, versions) live in Properties\AssemblyInfo.cs
         and must stay stable so existing VBA references keep working. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Strong name keeps the COM identity (PublicKeyToken d499ab7f7ba4d827) of released builds -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>2</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Test'">
    <DebugType>full</DebugType>
    <DefineConstants>TRACE;DEBUG;Test</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kept in the tree but excluded from the original build -->
    <Compile Remove="ComInterfaces\_IME.cs;Common\IME.cs;Internal\HotKeyGlobalLL.cs;Internal\FolderCache.cs" />
    <None Include="ComInterfaces\_IME.cs;Common\IME.cs;Internal\HotKeyGlobalLL.cs;Internal\FolderCache.cs" />
    <Compile Update="Internal\ExceptionDialog.cs" SubType="Form" />
    <Compile Update="Internal\ExceptionDialog.Designer.cs" DependentUpon="ExceptionDialog.cs" />
  </ItemGroup>

  <!-- Copy bundled drivers next to the assembly when present in ..\References -->
  <ItemGroup>
    <DriverBinary Include="..\References\firefoxdriver.xpi;..\References\chromedriver.exe;..\References\operadriver.exe;..\References\iedriver.exe;..\References\iedriver64.exe;..\References\phantomjs.exe" />
  </ItemGroup>
  <Target Name="CopyDriverBinaries" AfterTargets="Build">
    <Copy SourceFiles="@(DriverBinary)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>

</Project>
